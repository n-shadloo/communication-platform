[Unit]
Description=chat backend retention pruning
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=deploy
Group=www-data
UMask=0027
WorkingDirectory=/srv/chat/backend
EnvironmentFile=/srv/chat/backend/.env.production
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
# Deletes expired queue rows, flushes expired refresh tokens, GCs unreferenced
# attachments. Ciphertext and metadata only; never a remote-wipe guarantee.
ExecStart=/srv/chat/backend/.venv/bin/python manage.py prune

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/srv/chat/backend/media_root
