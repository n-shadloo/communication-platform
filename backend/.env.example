# Environment for the chat backend.
#
# Development: copy to `.env` and export it into your shell before running
# manage.py or pytest:
#
#     set -a; source .env; set +a
#
# Production: copy to /srv/chat/backend/.env.production (root-owned, mode 0640);
# the systemd units load it via EnvironmentFile. Neither copy is ever committed.
#
# Generate every secret below with:
#
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Secrets here are infrastructure secrets. None of them can decrypt any message:
# content keys never reach this server.

# --- Django core ---------------------------------------------------------------
# config.settings.dev for development, config.settings.prod on the VPS.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
# Comma-separated. Must list the real hostname in production.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Path the stock admin is mounted at. Pick something non-obvious in production.
ADMIN_PATH=admin/

# --- PostgreSQL (localhost only) -----------------------------------------------
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Must stay 0. Django's psycopg pool refuses a higher value, and nothing in this
# process fires the request signals that would reap a persistent connection.
DB_CONN_MAX_AGE=0
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=16
DB_POOL_TIMEOUT=10

# --- Redis (localhost only, non-persistent) ------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth ----------------------------------------------------------------------
JWT_SIGNING_KEY=
ACCESS_MIN=15
REFRESH_DAYS=14
REGISTER_SCOPE_ACCESS_MIN=10

# --- Request limits ------------------------------------------------------------
# One process on 1 GB of RAM has no headroom for an unbounded body or a request
# that never ends. A request past its deadline answers 503; a body above its cap
# answers 413. The upload class covers the routes the Django application still
# serves, whose largest body is a 64 MiB attachment; nginx caps the same value.
REQUEST_DEADLINE_SECONDS=15
UPLOAD_DEADLINE_SECONDS=120
BODY_CAP_JSON_BYTES=16384
BODY_CAP_BACKUP_BYTES=2097152
BODY_CAP_UPLOAD_BYTES=73400320

# --- Throttle rates ------------------------------------------------------------
# Counted in Redis, keyed on the account for an authenticated request and on the
# client address otherwise. A throttled route fails closed with 503 when Redis is
# unreachable.
THROTTLE_REGISTER=10/hour
THROTTLE_LOGIN=20/hour
THROTTLE_REFRESH=120/hour
THROTTLE_ACCOUNTS=120/min
THROTTLE_CLAIM=120/min
THROTTLE_ENVELOPES=600/min
THROTTLE_ATTACHMENTS=60/min
THROTTLE_ROOMTOKEN=60/min

# --- Storage, quotas and retention ---------------------------------------------
# Development falls back to <repo>/media_root when unset; production uses the
# deploy path.
ATTACHMENTS_ROOT=/srv/chat/backend/media_root
ATTACH_USER_QUOTA_BYTES=2147483648
ATTACH_TTL_DAYS=30
# Governs only undelivered envelopes (delivery deletes on ack). 7 days bounds a
# seizure's take and is also the window an offline device has to collect its
# mail before it must repair the pairwise sessions whose messages were pruned.
ENVELOPE_TTL_DAYS=7
MAX_DEVICES_PER_USER=10

# --- Realtime ------------------------------------------------------------------
# Comma-separated WebSocket Origin allowlist. Required in production; an empty
# value fails `manage.py check --deploy`.
ALLOWED_WS_ORIGINS=https://chat.nimashadloo.dev
WS_MAX_FRAME=524288
SIGNAL_MAX=16384

# --- Voice / LiveKit -----------------------------------------------------------
# The API secret mints join tokens. It is never a media key: SFrame keys are derived
# client-side and never sent to this server or the SFU.
# An empty LIVEKIT_URL disables voice (the token endpoint answers 503).
# In production: wss://chat.nimashadloo.dev — nginx proxies /rtc to LiveKit on
# loopback:7880.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=300
# coturn (relay-only TURN for voice, ops/coturn/turnserver.conf). The static secret
# mints ephemeral relay credentials; it is infrastructure, never a media key.
TURN_REALM=chat.nimashadloo.dev
TURN_STATIC_AUTH_SECRET=
