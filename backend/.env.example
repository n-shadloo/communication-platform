# Environment for the chat backend. Copy to `.env` and fill in real values.
#
# `.env` is gitignored and never committed. In production systemd loads it via
# EnvironmentFile; in development export it into your shell before running
# manage.py or pytest:
#
#     set -a; source .env; set +a
#
# Generate every secret below with:
#
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Secrets here are *infrastructure* secrets (ARCHITECTURE §A12). None of them can
# decrypt any message: content keys never reach this server.

# --- Django core ---------------------------------------------------------------
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret
# Comma-separated. Must list the real hostname in production.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Path the stock admin is mounted at. Pick something non-obvious in production.
ADMIN_PATH=admin/

# --- PostgreSQL (localhost only) -----------------------------------------------
POSTGRES_DB=chatapp
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=replace-me-with-a-generated-secret
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis (localhost only, non-persistent) ------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth (ARCHITECTURE §A8) ---------------------------------------------------
JWT_SIGNING_KEY=replace-me-with-a-generated-secret
ACCESS_MIN=15
REFRESH_DAYS=14
REGISTER_SCOPE_ACCESS_MIN=10

# --- Throttle rates (DRF scopes, ARCHITECTURE §A5) -----------------------------
THROTTLE_REGISTER=10/hour
THROTTLE_LOGIN=20/hour
THROTTLE_REFRESH=120/hour
THROTTLE_ACCOUNTS=120/min
THROTTLE_CLAIM=120/min
THROTTLE_ENVELOPES=600/min
THROTTLE_ATTACHMENTS=60/min
THROTTLE_ROOMTOKEN=60/min

# --- Storage, quotas and retention (ARCHITECTURE §A4, §A7, §A13) ---------------
ATTACHMENTS_ROOT=/etc/chatapp/media_root
ATTACH_USER_QUOTA_BYTES=2147483648
ATTACH_TTL_DAYS=30
ENVELOPE_TTL_DAYS=30
# 0 keeps encrypted history forever (the default; best multi-device sync).
HISTORY_TTL_DAYS=0
MAX_DEVICES_PER_USER=10

# --- Realtime (ARCHITECTURE §A6) -----------------------------------------------
# Comma-separated WebSocket Origin allowlist.
ALLOWED_WS_ORIGINS=https://YOUR_DOMAIN
WS_MAX_FRAME=524288
SIGNAL_MAX=16384

# --- Voice / LiveKit (ARCHITECTURE §A9) ----------------------------------------
# The API secret mints join tokens. It is never a media key: SFrame keys are derived
# client-side and never sent to this server or the SFU.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=300
