# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Env & secrets — never in git
.env
.env.*
!.env.example
ops/tls/out/

# Runtime artifacts
media_root/
static_root/
*.log

# Test & tooling caches
.pytest_cache/
.coverage
htmlcov/

# OS noise and stray local databases
.DS_Store
*.sqlite3

# The offline wheel cache. The operator builds it on the VPS with ops/vendor.sh while
# the network is available, and ops/offline_install.sh installs from it. It is a
# large binary artifact rebuilt from requirements/, so it never enters git.
vendor/

# The CycloneDX document ops/gen_sbom.sh writes. It is derived from
# requirements/, so a committed copy goes stale the moment a pin moves;
# regenerate it with the release it describes and keep it beside the artefact.
ops/sbom.*.json
