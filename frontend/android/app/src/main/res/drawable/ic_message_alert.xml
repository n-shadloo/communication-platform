<!--
  The status-bar icon for a message alert.

  A notification small icon is rendered as a monochrome silhouette: the system
  keeps the alpha channel and discards the colour, so this is drawn in solid
  white and carries no detail that only survives in colour. It is deliberately
  a plain speech bubble and not a brand mark - the icon sits in the status bar
  whenever something is waiting, and a distinctive mark would make the
  application recognisable at a glance to anyone looking at the phone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,3h16c1.1,0 2,0.9 2,2v10c0,1.1 -0.9,2 -2,2H9l-5,4v-4c-1.1,0 -2,-0.9 -2,-2V5c0,-1.1 0.9,-2 2,-2z" />
</vector>
